{
  "expo": {
    "name": "SpendSense",
    "slug": "spendsense",
    "scheme": "spendsense",
    "version": "1.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSCameraUsageDescription": "SpendSense uses your camera to scan receipts and add them as expenses.",
        "NSPhotoLibraryUsageDescription": "SpendSense accesses your photos to import receipts.",
        "NSFaceIDUsageDescription": "SpendSense uses Face ID to protect your financial data."
      }
    },
    "android": {
      "package": "com.spendsense.app",
      "usesCleartextTraffic": true,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#FFFFFF"
      },
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.RECORD_AUDIO",
        "android.permission.READ_SMS",
        "android.permission.RECEIVE_SMS"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-camera",
        {
          "cameraPermission": "SpendSense needs camera access to scan receipts."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "SpendSense accesses your photos to import receipt images."
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "SpendSense uses Face ID to secure your financial data."
        }
      ]
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "7737ab9d-0dfc-4aa3-be8d-3a0569a3ea49"
      }
    },
    "owner": "kedemstudios"
  }
}
